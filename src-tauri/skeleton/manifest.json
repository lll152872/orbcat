      "template": true
    },
    {
      "src": "pending/README.md",
      "rel": "pending/README.md",
      "template": true
    },
    {
      "src": "projects/README.md",
      "rel": "projects/README.md",
      "template": true
    },

    {
      "src": "RULES.md",
      "rel": "RULES.md",
      "template": true
    },
    {
      "src": "SOUL.md",
      "rel": "SOUL.md",
      "template": true
    },
    {
      "src": "IDENTITY.md",
      "rel": "IDENTITY.md",
      "template": true
    },
    {
      "src": "USER.md",
      "rel": "USER.md",
      "template": true
    },

    {
