{
  "name": "float-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "npm run test:ui && npm run test:rust",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:rust": "cargo test --lib --manifest-path src-tauri/Cargo.toml",
    "test:e2e:mock": "python tests/e2e/mock_openai.py",
    "test:e2e:live": "python tests/e2e/run_live_flow.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^8.0.16",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4",
    "happy-dom": "^20.0.0"
  }
}
