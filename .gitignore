# ============================================================
#  运行时数据 —— 绝不进仓
# ============================================================
#  agent-data/ 里是 agent 的"真身"：API key、会话原文、截图、
#  日记、记忆、技能。每台机器各自一份，仓库不存。
#
#  新克隆的人怎么办？让 agent 读仓库根的 `初始化.md` 自建。
# ============================================================
agent-data/
**/agent-data/

# 环境变量覆盖时可能落在这两个位置的副本
/agent-data.bak/
/agent-data.old/

# ============================================================
#  Node / 前端
# ============================================================
node_modules
dist
dist-ssr
*.local

# ============================================================
#  Rust / Tauri 构建产物
# ============================================================
/src-tauri/target/
**/target/
/gen/schemas/

# ============================================================
#  日志
# ============================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
#  调试产生的临时文件
# ============================================================
# 本项目开发期的习惯：临时排查输出用 `_` 前缀。全是垃圾，别进仓。
_*.txt
_*.log
_*.json
_*.py
_*.png
_*.jpg

# ============================================================
#  编辑器 / 系统
# ============================================================
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================================
#  凭据兜底 —— 万一有人改错了路径
# ============================================================
models.json
*.key
.env
.env.*
!.env.example

# ============================================================
#  调试符号残留
# ============================================================
# src-tauri/tmp_probe.pdb（1.2 MB）曾误入工作树
*.pdb
*.ilk

# ============================================================
#  开发期临时目录
# ============================================================
# tmp/ 下是排查脚本、旧文件备份、探针输出（如 _main.ts.bak 255 KB）。
# 不是运行时组件，也不是发布产物。
/tmp/

# ============================================================
#  内置运行时资产（2026-10-22）
# ============================================================
#  runtime/  = 构建产物：node.exe / python embeddable / 裁剪版 git+bash / pi 内核
#              共 179.1 MB，**由 tools/build-runtime-assets.mjs 生成**，不进仓。
#              发布时由打包脚本从构建产物里取，不从仓库取。
runtime/
runtime.*/
#  .cache/    = 构建脚本的下载缓存（node.exe / python zip / pi npm 包）
#              大文件 + 可重新下载，不进仓。
tools/.cache/

# ============================================================
#  无头验证探针目录（2026-10-23）
# ============================================================
#  probeN/ = exe + dist + agent-data 的隔离副本，跑完即弃。
#  13 MB 的 exe 副本堆在仓库根会污染 git status，不进仓。
probeN*/

# 纯 HTML 预览件（构建产物：npm run build:preview ⇒ preview/preview.html）
preview
